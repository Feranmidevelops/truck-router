DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# true = canned responses from routing/fixtures (no API keys needed)
USE_FIXTURES=true
TOMTOM_API_KEY=
GEOCODE_COUNTRY_SET=US
# Proxies in front of the app that append to X-Forwarded-For (0 locally, 2 on Render)
NUM_PROXIES=0
